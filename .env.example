# Docker Compose settings, placed in the project ROOT .env
# GHCR_OWNER must be lowercase and match your GitHub user/org namespace.
GHCR_OWNER=yourgithubuser
DATABASE_NAME=films
DATABASE_USERNAME=film_user
DATABASE_PASSWORD=replace_with_a_strong_password
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=replace_with_another_strong_password
LOGGER_FORMAT=json
