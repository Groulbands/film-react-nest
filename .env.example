# Copy this file to .env in the project root; never commit .env.
# The same .env is passed to the containers with env_file.
GHCR_OWNER=yourgithubuser
NODE_ENV=production
PORT=3000
LOGGER_FORMAT=json
DATABASE_DRIVER=postgres
DATABASE_NAME=films
DATABASE_USERNAME=film_user
DATABASE_PASSWORD=replace_with_a_strong_password
DATABASE_URL=postgres://database:5432/${DATABASE_NAME}
# Docker Compose expands these aliases using the values above.
POSTGRES_DB=${DATABASE_NAME}
POSTGRES_USER=${DATABASE_USERNAME}
POSTGRES_PASSWORD=${DATABASE_PASSWORD}
# Only needed when starting the optional local pgAdmin profile.
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=replace_with_another_strong_password
